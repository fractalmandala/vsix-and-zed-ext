  "semanticTokenColors": {
    "type": "#07AB23",
    "class": "#07AB23",
    "interface": "#07AB23",
    "enum": "#07AB23",
    "namespace": "#07AB23",
    "function": "#303030",
    "method": "#303030",
    "variable": "#303030",
    "parameter": "#303030",
    "property": "#07AB23",
    "enumMember": "#07AB23",
    "keyword": "#12B533",
    "operator": "#8F8F8F",
    "string": "#07AB23",
    "number": "#07AB23",
    "comment": {
      "foreground": "#6E747A",
      "fontStyle": "italic"
    },
    "*.deprecated": {
      "strikethrough": true
    }
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#6E747A",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#12B533"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#07AB23"
      }
    },
    {
      "name": "Number / constant",
      "scope": [
        "constant.numeric",
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#07AB23"
      }
    },
    {
      "name": "Function",
      "scope": [
        "entity.name.function",
        "support.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#303030"
      }
    },
    {
      "name": "Type / class",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#07AB23"
      }
    },
    {
      "name": "Operator",
      "scope": [
        "keyword.operator",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#8F8F8F"
      }
    },
    {
      "name": "Variable / property",
      "scope": [
        "variable",
        "variable.other",
        "variable.parameter",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#303030"
      }
    },
    {
      "name": "Markdown heading",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#07AB23",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#E65050"
      }
    }
  ]
}
